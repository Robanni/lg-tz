POSTGRES_DB=lg_tz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5436

DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/lg_tz
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5436/lg_tz

AUTH_SECRET_KEY=change-me-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
