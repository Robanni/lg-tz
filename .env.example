POSTGRES_DB=lg_tz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5436

DEBUG=true

# Локальный запуск (mise / uv напрямую)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/lg_tz
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5436/lg_tz

# Docker Compose: замените localhost → db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lg_tz
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lg_tz

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
